{
  "name": "@tracebee/sdk",
  "version": "0.1.2",
  "license": "MIT",
  "description": "TypeScript SDK for Tracebee — observability for LLM agents",
  "keywords": [
    "llm",
    "openai",
    "observability",
    "tracing",
    "agents",
    "telemetry"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psimanta/tracebee.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/psimanta/tracebee/tree/main/packages/sdk#readme",
  "bugs": "https://github.com/psimanta/tracebee/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "openai": "^6.34.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "ulid": "^3.0.2"
  }
}
